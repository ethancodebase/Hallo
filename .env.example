# Pooled connection string (used by the app at runtime).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE?sslmode=require"
# Optional direct connection string (used by Prisma migrations). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here"

# TURN relay (optional, server-only — never prefix with NEXT_PUBLIC_).
# Lets chat/video connect through VPNs, symmetric NATs and UDP-blocking firewalls.
# Set ONE provider; with none, peers use STUN only (direct connections).
# Cloudflare Realtime TURN:
# CLOUDFLARE_TURN_KEY_ID=""
# CLOUDFLARE_TURN_API_TOKEN=""
# Metered (https://www.metered.ca/stun-turn):
# METERED_TURN_DOMAIN="yourapp.metered.live"
# METERED_TURN_API_KEY=""
# Any standard TURN server (static credentials):
# TURN_URLS="turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp"
# TURN_USERNAME=""
# TURN_CREDENTIAL=""
